<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_midnight"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Top Bar: City & Hijri (Toggleable) -->
    <LinearLayout
        android:id="@+id/widget_next_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Minar • Ikast"
            android:textColor="#E8C582"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="16 Jumādá"
            android:textColor="#7E8EA6"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Flexible spacer between header and middle content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- NEXT badge + Prayer Name row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_gold"
            android:maxLines="1"
            android:paddingHorizontal="5dp"
            android:paddingVertical="1.5dp"
            android:text="NEXT"
            android:textColor="#E8C582"
            android:textSize="8.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="İMSAK"
            android:textColor="#F4DC9F"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Huge Time Display (Never truncated, never overlaps) -->
    <TextView
        android:id="@+id/widget_next_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:layout_marginBottom="1dp"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="06:05"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold" />

    <!-- Flexible spacer between time and countdown pill -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: Countdown Pill (Fixed at bottom) -->
    <LinearLayout
        android:id="@+id/widget_next_remaining_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_gold"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2.5dp">

        <TextView
            android:id="@+id/widget_next_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="in 9h 17m"
            android:textColor="#F4DC9F"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
