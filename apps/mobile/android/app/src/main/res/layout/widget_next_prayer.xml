<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_midnight"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Bar: City & Hijri (Toggleable) -->
    <LinearLayout
        android:id="@+id/widget_next_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Minar • Ikast"
            android:textColor="#E8C582"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="16 Jumādá"
            android:textColor="#7E8EA6"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- Flexible spacer between header and middle content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- NEXT badge + Prayer Name row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_pill_gold"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingHorizontal="4.5dp"
            android:paddingVertical="1dp"
            android:text="NEXT"
            android:textColor="#E8C582"
            android:textSize="8sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="İMSAK"
            android:textColor="#F4DC9F"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Huge Time Display (Never truncated, never overlaps) -->
    <TextView
        android:id="@+id/widget_next_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:singleLine="true"
        android:text="06:05"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Flexible spacer between time and countdown pill -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom: Countdown Pill (Fixed at bottom, never overlaps) -->
    <LinearLayout
        android:id="@+id/widget_next_remaining_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill_gold"
        android:paddingHorizontal="7dp"
        android:paddingVertical="2dp">

        <TextView
            android:id="@+id/widget_next_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:singleLine="true"
            android:text="in 9h 17m"
            android:textColor="#F4DC9F"
            android:textSize="9.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
