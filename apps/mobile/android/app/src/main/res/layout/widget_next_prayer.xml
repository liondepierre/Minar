<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="16dp">

    <!-- Top Bar: City & Hijri -->
    <LinearLayout
        android:id="@+id/widget_next_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_next_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ikast, Denmark"
            android:textColor="#E8C582"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_next_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="17 Cemaziyelahir"
            android:textColor="#7E8EA6"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/widget_next_remaining_container"
        android:layout_below="@id/widget_next_header"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- NEXT badge + Prayer Name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_next_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_pill_gold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="NEXT"
                android:textColor="#E8C582"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_next_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="İMSAK"
                android:textColor="#F4DC9F"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Huge Time Display -->
        <TextView
            android:id="@+id/widget_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:text="06:05"
            android:textColor="#FFFFFF"
            android:textSize="44sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom: Countdown Pill -->
    <LinearLayout
        android:id="@+id/widget_next_remaining_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/widget_cell_active"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/widget_next_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="in 9h 35m"
            android:textColor="#E8C582"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
