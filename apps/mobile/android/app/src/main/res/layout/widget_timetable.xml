<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timetable_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_midnight"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Row: Live Clock (Left) + Location & Date (Right) -->
    <LinearLayout
        android:id="@+id/widget_tt_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextClock
            android:id="@+id/widget_tt_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="hh:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_tt_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Minar"
                android:textColor="#E8C582"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_tt_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="27 Nov • 18 Cemaziyelahir"
                android:textColor="#7E8EA6"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 1x6 Horizontal Timetable Row (All 6 Salah Times) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 0: Fajr -->
        <LinearLayout
            android:id="@+id/widget_cell_0"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_active_gold"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_name_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="İMSAK"
                android:textColor="#E8C582"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_time_0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="06:06"
                android:textColor="#F4DC9F"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1: Sunrise -->
        <LinearLayout
            android:id="@+id/widget_cell_1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_normal_amoled"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_name_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="GÜNEŞ"
                android:textColor="#7E8EA6"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_time_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="08:16"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2: Dhuhr -->
        <LinearLayout
            android:id="@+id/widget_cell_2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_normal_amoled"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_name_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="ÖĞLE"
                android:textColor="#7E8EA6"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_time_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="12:16"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3: Asr -->
        <LinearLayout
            android:id="@+id/widget_cell_3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_normal_amoled"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_name_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="İKİNDİ"
                android:textColor="#7E8EA6"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_time_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="13:45"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 4: Maghrib -->
        <LinearLayout
            android:id="@+id/widget_cell_4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="2.5dp"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_normal_amoled"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_name_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="AKŞAM"
                android:textColor="#7E8EA6"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_time_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="16:05"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 5: Isha -->
        <LinearLayout
            android:id="@+id/widget_cell_5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_cell_normal_amoled"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="1dp"
            android:paddingVertical="2dp">

            <TextView
                android:id="@+id/widget_name_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:singleLine="true"
                android:text="YATSI"
                android:textColor="#7E8EA6"
                android:textSize="8.5sp" />

            <TextView
                android:id="@+id/widget_time_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="18:01"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Pill: Next Prayer Countdown Bar -->
    <LinearLayout
        android:id="@+id/widget_tt_bottom_pill"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_pill_container"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3.5dp">

        <TextView
            android:id="@+id/widget_tt_bottom_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="İmsak vaktine kalan: 8:01"
            android:textColor="#E8C582"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
