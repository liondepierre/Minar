<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timetable_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_midnight"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Header (Toggleable) -->
    <LinearLayout
        android:id="@+id/widget_tt_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="3dp">

        <TextView
            android:id="@+id/widget_tt_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Minar • Tokyo"
            android:textColor="#E8C582"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_tt_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="26 Nov • 16 Jumādá"
            android:textColor="#7E8EA6"
            android:textSize="9.5sp" />
    </LinearLayout>

    <!-- 2x3 Grid Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: Fajr, Sunrise, Dhuhr -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Fajr -->
            <LinearLayout
                android:id="@+id/widget_cell_0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_active_gold"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="1dp"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_name_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="İMSAK"
                    android:textColor="#E8C582"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_time_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="06:05"
                    android:textColor="#F4DC9F"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Sunrise -->
            <LinearLayout
                android:id="@+id/widget_cell_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_normal_amoled"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="1dp"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_name_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="GÜNEŞ"
                    android:textColor="#7E8EA6"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="08:15"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dhuhr -->
            <LinearLayout
                android:id="@+id/widget_cell_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_normal_amoled"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="1dp"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_name_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="ÖĞLE"
                    android:textColor="#7E8EA6"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="12:16"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Asr, Maghrib, Isha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Asr -->
            <LinearLayout
                android:id="@+id/widget_cell_3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_normal_amoled"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="1dp"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_name_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="İKİNDİ"
                    android:textColor="#7E8EA6"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="13:46"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:id="@+id/widget_cell_4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_normal_amoled"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="1dp"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_name_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="AKŞAM"
                    android:textColor="#7E8EA6"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="16:04"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Isha -->
            <LinearLayout
                android:id="@+id/widget_cell_5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_cell_normal_amoled"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="1dp"
                android:paddingVertical="1dp">

                <TextView
                    android:id="@+id/widget_name_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="YATSI"
                    android:textColor="#7E8EA6"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/widget_time_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text="18:07"
                    android:textColor="#FFFFFF"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
